pipeline {
    agent any
    stages {
        stage('Checkout') {
            steps {
                git branch: 'Jenkins_project', url: 'https://github.com/Pavithrasanan/my_project.git'  // Replace with your repo URL
            }
        }
        stage('Print Message') {
            steps {
                sh 'echo "Hello from Jenkins!"'
            }
        }
    }
    post {
        always {
            emailext (
                subject: "${env.JOB_NAME} - Build #${env.BUILD_NUMBER} - ${currentBuild.currentResult}",
                body: """Build: ${env.JOB_NAME} - #${env.BUILD_NUMBER}
Status: ${currentBuild.currentResult}
Details: ${env.BUILD_URL}
Check console output for more details.""",
                to: "PAVITHRASENAN21@GMAIL.COM",
                attachLog: true
            )
        }
    }
}