pipeline {
    agent any  // Runs on any available agent (assumes Ubuntu/Debian)
    stages {
        stage('Install Python') {
            steps {
                // Update package list and install Python 3
                sh '''
                sudo apt-get update
                sudo apt-get install -y python3 python3-pip
                python3 --version
                '''
            }
        }
        stage('Checkout') {
            steps {
                // Pull the latest code from your repository
                git branch: 'main', url: 'https://github.com/Pavithrasanan/my_project.git'  //
            }
        }
        stage('Run Python Script') {
            steps {
                // Execute the Python script
                sh 'python3 hello.py' 
            }
        }
    }
    post {
        always {
            // Send email notification with build status
            emailext (
                subject: "${env.JOB_NAME} - Build #${env.BUILD_NUMBER} - ${currentBuild.currentResult}",
                body: """Build: ${env.JOB_NAME} - #${env.BUILD_NUMBER}
Status: ${currentBuild.currentResult}
Details: ${env.BUILD_URL}
Check console output for more details.""",
                to: "pavithrasenan21@gmail.com",
                attachLog: true
            )
        }
    }
}